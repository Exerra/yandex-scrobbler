# Yandex Music OAuth token
# Obtain from: https://oauth.yandex.com/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_MUSIC_TOKEN=

# Last.fm API credentials
# Create at: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Last.fm session key
# Obtain by running: bun run auth
LASTFM_SESSION_KEY=

# Polling interval in seconds (default: 15, minimum: 5)
POLLING_INTERVAL_SECONDS=15

# Log level: "debug" or "info" (default: "info")
LOG_LEVEL=info
